{
  "name": "snk-addon-plugin",
  "version": "0.6.0",
  "description": "Plugin Vite para preparar addons HTML compatíveis com Sankhya.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.js",
      "default": "./dist/utils.js"
    }
  },
  "keywords": [
    "vite",
    "sankhya",
    "addon",
    "frontend"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "bun build ./src/index.ts ./src/react.ts ./src/utils.ts --outdir ./dist --target node --format esm --sourcemap=linked --external react --external react-dom --external react-dom/client && tsc -p tsconfig.package.json && bun run scripts/copy-assets.ts",
    "test": "bun test",
    "prepack": "bun run build && bun test"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^6.0.3",
    "vite": "^7.0.0 || ^8.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  },
  "peerDependencies": {
    "vite": "^7.0.0 || ^8.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "packageManager": "bun@1.3.14"
}
